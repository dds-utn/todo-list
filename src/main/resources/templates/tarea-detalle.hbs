<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Tarea - {{tarea.descripcion}}</title>
    <link rel="stylesheet" href="/css/estilo-minimal.css">
</head>
<body>
<div class="container">
    <a class="link-volver" href="/tareas">&larr; Volver al listado</a>

    <h1>{{tarea.descripcion}}</h1>

    <div class="detalle-meta">
        <span class="tag {{tarea.prioridadCssClass}}">{{tarea.prioridad}}</span>
        {{#if tarea.completada}}
        <span class="badge badge-done">Completada</span>
        {{else}}
        <span class="badge badge-pending">Pendiente</span>
        {{/if}}
    </div>

    <section class="detalle-seccion">
        <h2>Detalle</h2>
        <p>{{tarea.detalle}}</p>
    </section>

    <section class="detalle-seccion">
        <h2>Adjuntos</h2>
        {{#if tarea.tieneAdjuntos}}
        <div class="adjuntos-lista">
            {{#each tarea.adjuntos}}
            <a class="adjunto" href="{{this}}" target="_blank" rel="noopener">
                <img src="{{this}}" alt="Adjunto de la tarea">
            </a>
            {{/each}}
        </div>
        {{else}}
        <p class="sin-adjuntos">No hay adjuntos todavía.</p>
        {{/if}}

        <form class="subir-adjunto-form">
            <input type="file" name="adjunto">
            <button type="submit" disabled>Subir (demo, sin funcionalidad)</button>
        </form>
    </section>
</div>
</body>
</html>
