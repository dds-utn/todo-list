{{#partial "titulo"}}Tarea - {{tarea.descripcion}}{{/partial}}

{{#partial "contenido"}}
<a class="btn btn-ghost" href="/tareas">&larr; Volver al listado</a>

<header>
    <h1>{{tarea.descripcion}}</h1>

    <div class="detalle-meta">
        <span class="tag {{tarea.prioridadCssClass}}">Prioridad: {{tarea.prioridad}}</span>
        {{#if tarea.completada}}
        <span class="badge badge-done">Completada</span>
        {{else}}
        <span class="badge badge-pending">Pendiente</span>
        {{/if}}
    </div>

    <div class="detalle-acciones">
        {{#unless tarea.completada}}
        <form method="post" action="/tareas/{{tarea.id}}/completar">
            <button type="submit" class="btn btn-success" aria-label="Completar tarea: {{tarea.descripcion}}">Completar tarea</button>
        </form>
        {{/unless}}
        <form method="post" action="/tareas/{{tarea.id}}/eliminar" onsubmit="return confirm('¿Seguro que querés borrar esta tarea?')">
            <button type="submit" class="btn btn-danger" aria-label="Borrar tarea: {{tarea.descripcion}}">Borrar tarea</button>
        </form>
    </div>
</header>

<main>
    <section class="detalle-seccion" aria-labelledby="detalle-heading">
        <h2 id="detalle-heading">Detalle</h2>
        <p>{{tarea.detalle}}</p>
    </section>

    <section class="detalle-seccion" aria-labelledby="adjuntos-heading">
        <h2 id="adjuntos-heading">Adjuntos</h2>
        {{#if tarea.tieneAdjuntos}}
        <div class="adjuntos-lista">
            {{#each tarea.adjuntos}}
            <a class="adjunto" href="{{this}}" target="_blank" rel="noopener" aria-label="Ver adjunto {{@index}} en tamaño completo">
                <img src="{{this}}" alt="Adjunto {{@index}} de la tarea {{../tarea.descripcion}}" loading="lazy">
            </a>
            {{/each}}
        </div>
        {{else}}
        <p class="sin-adjuntos">No hay adjuntos todavía.</p>
        {{/if}}

        <form class="subir-adjunto-form" aria-label="Subir adjunto (demostración, sin funcionalidad)">
            <label class="visually-hidden" for="adjunto">Subir adjunto</label>
            <input id="adjunto" type="file" name="adjunto" disabled>
            <button type="submit" class="btn btn-secondary" disabled title="Funcionalidad de subida no implementada">Subir (demo)</button>
        </form>
    </section>
</main>
{{/partial}}

{{> layout}}
