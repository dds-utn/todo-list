<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Tareas</title>
</head>
<body>
<h1>Lista de tareas</h1>
<table border="1" cellpadding="6" cellspacing="0">
    <thead>
    <tr>
        <th>ID</th>
        <th>Descripción</th>
        <th>Completada</th>
    </tr>
    </thead>
    <tbody>
    {{#each tareas}}
    <tr>
        <td>{{this.id}}</td>
        <td>{{this.descripcion}}</td>
        <td>{{#if this.completada}}Sí{{else}}No{{/if}}</td>
    </tr>
    {{/each}}
    </tbody>
</table>
</body>
</html>
