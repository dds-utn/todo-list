<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Tareas</title>
    <link rel="stylesheet" href="/css/estilo-minimal.css">
</head>
<body>
<div class="container">
    <h1>Lista de tareas</h1>
    <form class="busqueda-form" method="get" action="/tareas">
        <input type="text" name="nombre" placeholder="Buscar por nombre..." value="{{nombre}}">
        <button type="submit">Buscar</button>
    </form>
    <table class="tareas-table">
        <thead>
        <tr>
            <th>ID</th>
            <th>Descripción</th>
            <th>Completada</th>
        </tr>
        </thead>
        <tbody>
        {{#each tareas}}
        <tr>
            <td>{{this.id}}</td>
            <td>{{this.descripcion}}</td>
            <td>
                {{#if this.completada}}
                <span class="badge badge-done">Sí</span>
                {{else}}
                <span class="badge badge-pending">No</span>
                {{/if}}
            </td>
        </tr>
        {{/each}}
        </tbody>
    </table>
</div>
</body>
</html>
